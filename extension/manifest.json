{
  "manifest_version": 3,
  "name": "JobFlow Autofill v2",
  "version": "2.0.0",
  "description": "API-backed extension that injects a floating button for 1-click filling.",
  "permissions": [],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobFlow Autofill"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
