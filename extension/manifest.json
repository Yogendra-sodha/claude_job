{
  "manifest_version": 3,
  "name": "JobFlow Autofill v2",
  "version": "2.10.1",
  "description": "Section-aware autofill for Workday, Greenhouse, Lever, iCIMS, Ashby and career pages, with main-world value setting for reliable React/Angular fills.",
  "permissions": [],
  "host_permissions": ["*://*/*", "http://127.0.0.1:3000/*", "http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobFlow Autofill"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["mainworld.js"],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["matcher.js", "content.js"],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
