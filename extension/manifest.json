{
  "manifest_version": 3,
  "name": "JobFlow Autofill v2",
  "version": "2.3.0",
  "description": "Auto-fills job forms on load and through multi-step flows (Workday, Greenhouse, Lever, LinkedIn, Oracle). Shadow-DOM aware, React-safe.",
  "permissions": [],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobFlow Autofill"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
