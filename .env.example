# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=jobflow

# Server
PORT=3000

# AI autofill key (OpenAI / DeepSeek / OpenRouter / … — any OpenAI-compatible key).
# Model and base URL are configured in the app's Settings → AI. Restart after changing.
AI_API_KEY=
# OPENAI_API_KEY is also accepted as an alias.
